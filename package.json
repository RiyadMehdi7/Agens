{
  "name": "agens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env.local server/index.ts",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "build": "tsc && vite build",
    "test": "tsx --test tests/*.test.ts",
    "verify:gemini": "tsx --env-file-if-exists=.env.local scripts/verify-gemini.ts",
    "setup:matrix": "bash scripts/matrix-bootstrap.sh",
    "dev:web": "vite",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env.local dist/server/index.js",
    "demo": "npm run build && npm start",
    "smoke:demo": "tsx scripts/demo-smoke.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "exceljs": "^4.4.0",
    "pg": "^8.16.3",
    "yauzl": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
